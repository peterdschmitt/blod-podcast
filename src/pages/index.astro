---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Signup from '../components/Signup.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import ExampleCard from '../components/ExampleCard.astro';
import { PLANNED } from '../site';
import { EXAMPLES, FACTS } from '../data/examples';

const guides = (await getCollection('guides', (g) => !g.data.draft))
  .sort((a, b) => +b.data.lastReviewed - +a.data.lastReviewed);
const featured = guides.find((g) => g.data.featured) ?? guides[0];
const publishedTitles = new Set(guides.map((g) => g.data.title));
const upcoming = PLANNED.filter((p) => !publishedTitles.has(p.title)).slice(0, 3);
const episodes = (await getCollection('episodes')).sort((a, b) => a.data.number - b.data.number);
const homeExamples = EXAMPLES.filter((e) => e.fits).slice(0, 3);
const statFacts = [FACTS.practices, FACTS.avgFee, FACTS.payments];
---
<Base>
  <div class="bento">
    <section class="span-all row">
      <div class="card hero-main rise">
        <span class="pill" style="align-self: flex-start"><span class="dot"></span>Blog + podcast · Independent, not an agency</span>
        <div>
          <h1 class="display">Direct primary care, <em>explained.</em></h1>
          <p class="lede">A blog and podcast on the fast-growing world of direct primary care and the coverage that goes around it. Plain-language explainers, real examples, and the math shown, including who it's wrong for.</p>
        </div>
        <div class="row hero-ctas" style="gap: 10px">
          <a href="/blog/" class="btn coral">Read the blog <Icon name="arrow" size={18} stroke={2.2} /></a>
          <a href="/podcast/" class="btn"><Icon name="headphones" size={18} /> Listen to the podcast</a>
        </div>
      </div>

      <div class="card bg-ink stack rise d2" aria-label="How a coverage stack fits together">
        <div class="stack-head"><span class="serif" style="font-size: 30px">Your stack</span><span style="font-size: 13px; color: var(--on-dark-faint)">2026 rules</span></div>
        <div class="layer optional drop"><span><b>Extras</b><small>Dental, vision, accident</small></span><span class="tag">Optional</span></div>
        <div class="layer drop" style="background: var(--lilac)"><span><b>HSA</b><small>Tax-free savings</small></span><Icon name="wallet" /></div>
        <div class="layer drop" style="background: var(--sage)"><span><b>Bronze or catastrophic</b><small>For the big, rare bills</small></span><Icon name="shield" /></div>
        <div class="layer base drop" style="background: var(--butter)"><span><b>Direct primary care</b><small>Your doctor, flat monthly fee</small></span><Icon name="stetho" /></div>
        <p style="margin: 12px 0 0; font-size: 14px; color: var(--on-dark-faint)">Each layer does one job. Most people need two or three, not all four.</p>
      </div>
    </section>

    <section class="span-all hub reveal">
      <div class="hub-col">
        <div class="hub-head"><h2>From the <em>blog</em></h2><a href="/blog/">All posts <Icon name="arrow" size={16} stroke={2.2} /></a></div>
        {featured && (
          <a href={`/blog/${featured.id}/`} class="feature bg-sage" style="padding: clamp(24px, 3vw, 36px)">
            <div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
              <span class="pill white" style="align-self: flex-start; font-weight: 600">Latest · {featured.data.readMinutes} min read</span>
              <h2 style="font-size: clamp(30px, 3.4vw, 44px)">{featured.data.title}</h2>
              <p style="margin: 0; font-size: 17px">{featured.data.dek}</p>
            </div>
            <span class="round-arrow"><Icon name="arrow-ne" size={28} color="#fff" stroke={2} /></span>
          </a>
        )}
        {upcoming.map((p) => (
          <div class="post-row" aria-label={`${p.title}, coming soon`}>
            <span class="meta"><span>{p.category}</span><span>Coming soon</span></span>
            <span class="t">{p.title}</span>
          </div>
        ))}
      </div>

      <div class="hub-col">
        <div class="hub-head"><h2>On the <em>podcast</em></h2><a href="/podcast/">All episodes <Icon name="arrow" size={16} stroke={2.2} /></a></div>
        <div class="pod-card bg-ink" style="flex: 1">
          <div class="row" style="gap: 12px; align-items: center">
            <span class="round-arrow" style="background: rgba(255,255,255,.12)"><Icon name="mic" size={26} color="#fff" /></span>
            <div><b style="font-size: 18px">Plain talk about the new way to cover yourself</b><p class="on-dark-muted" style="margin: 2px 0 0; font-size: 14px">Season one in production. Short, sourced episodes.</p></div>
          </div>
          <div class="episodes">
            {episodes.map((ep) => <EpisodeRow ep={ep} />)}
          </div>
          <a href="/podcast/" class="btn white small" style="align-self: flex-start">Get notified when it launches</a>
        </div>
      </div>
    </section>

    <section class="card span-all reveal" style="padding-bottom: 8px">
      <div class="section-head">
        <h2 class="h-xl">Why people are <em>switching.</em></h2>
        <p class="muted">Direct primary care is growing fast while traditional premiums climb.</p>
      </div>
    </section>
    {statFacts.map((f, i) => (
      <div class:list={['stat', 'reveal', ['bg-butter', 'bg-white', 'bg-lilac'][i]]}>
        <span class="eyebrow">{f.label}</span>
        <div><div class="num">{f.value}</div><p>{f.note}. Source: <a href={f.url}>{f.source}</a></p></div>
      </div>
    ))}
    <div class="stat bg-ink reveal">
      <span class="eyebrow">New for 2026</span>
      <div><div class="num">$150<small>/mo</small></div><p class="on-dark-muted">DPC fee you can pay alongside an HSA. Source: <a href="https://www.irs.gov/newsroom/treasury-irs-provide-guidance-on-new-tax-benefits-for-health-savings-account-participants-under-the-one-big-beautiful-bill">IRS Notice 2026-5</a></p></div>
    </div>

    <section class="span-all reveal" style="display: flex; flex-direction: column; gap: var(--gap)">
      <div class="hub-head"><h2>Why it makes sense: <em>real examples</em></h2><a href="/real-examples/">See all examples <Icon name="arrow" size={16} stroke={2.2} /></a></div>
      <div class="examples">
        {homeExamples.map((ex) => <ExampleCard ex={ex} />)}
      </div>
      <p class="muted" style="margin: 0 8px; font-size: 14px">Hypothetical households for education. Not advice about your situation. <a href="/real-examples/#turning-65">When it usually doesn't fit</a>.</p>
    </section>

    <section class="span-all row reveal">
      <div class="card bg-ink" style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 32px">
        <h2 class="h-xl">Compare stacks, <em>with the math shown.</em></h2>
        <p class="on-dark-muted" style="margin: 0; font-size: 18px">An expected year and a bad year for each option. Every formula published. Partner products are never pre-selected.</p>
        <a href="/calculator/" class="btn white small" style="align-self: flex-start">Open the calculator</a>
      </div>
      <div class="card calc-demo" aria-label="Calculator preview">
        <div class="row" style="gap: 8px">
          <label class="field">Household<select disabled><option>2 adults, 1 child</option></select></label>
          <label class="field">Expected usage<select disabled><option>Medium</option></select></label>
        </div>
        <div class="bar-row"><div class="top"><span>DPC + bronze + HSA</span><span>[$ —]</span></div><div class="bars"><span style="width: 18%; background: var(--accent)"></span><span style="width: 26%; background: var(--teal)"></span><span style="width: 8%; background: var(--steel)"></span></div></div>
        <div class="bar-row"><div class="top"><span>Silver plan alone</span><span>[$ —]</span></div><div class="bars"><span style="width: 62%; background: var(--warm-gray)"></span></div></div>
        <div class="bar-row"><div class="top"><span>DPC + catastrophic</span><span>[$ —]</span></div><div class="bars"><span style="width: 18%; background: var(--accent)"></span><span style="width: 20%; background: var(--teal)"></span></div></div>
        <p class="muted" style="margin: 4px 0 0; font-size: 13px">Illustrative layout. An estimate, not a recommendation. Confirm with HealthCare.gov, your state exchange, a navigator, or a licensed agent.</p>
      </div>
    </section>

    <section class="card span-all reveal">
      <div class="section-head">
        <h2 class="h-xl">Our promise: <em>no spin.</em></h2>
        <a href="/methodology/" style="font-weight: 600">Read the methodology</a>
      </div>
      <div class="mini-grid">
        <div class="promise"><Icon name="doc" size={26} /><h3>Same template for all</h3><p>Who it fits, who should skip it, costs, risks and evidence.</p></div>
        <div class="promise"><Icon name="ban" size={26} /><h3>No paid placement</h3><p>Nobody can buy a ranking. You choose the sort order.</p></div>
        <div class="promise"><Icon name="bars" size={26} /><h3>Evidence, graded</h3><p>Every study labeled: independent, actuarial, vendor-funded or anecdotal.</p></div>
        <div class="promise"><Icon name="gift" size={26} /><h3>Free help named first</h3><p>HealthCare.gov and navigators, before anyone who gets paid.</p></div>
      </div>
    </section>

    <div class="span-all"><Signup /></div>
  </div>
</Base>
