---
---
<section id="subscribe" class="signup bg-butter reveal">
  <h2 class="h-l">One email when the rules change. That's it.</h2>
  <form class="js-signup" name="subscribe" method="post" data-netlify="true">
    <label for="email" class="sr-only">Email address</label>
    <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="note" role="status" aria-live="polite"></p>
</section>
<script>
  // Placeholder until a newsletter provider is connected.
  document.querySelectorAll<HTMLFormElement>('.js-signup').forEach((f) => {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const note = f.parentElement!.querySelector('.note')!;
      note.textContent = 'Thanks. Sign-ups open at launch, and we will only write when the rules change.';
      f.reset();
    });
  });
</script>
